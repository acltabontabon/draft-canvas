{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Draft Canvas window may ask the shell to do. Every entry is one of the app's own commands; there is deliberately no fs, shell, event, opener or dialog permission, so the page can't reach a file that wasn't handed to it as a handle.",
  "windows": ["main"],
  "permissions": [
    "allow-host-ready",
    "allow-report-state",
    "allow-quit-ack",
    "allow-open-handle",
    "allow-save-document",
    "allow-save-as",
    "allow-rename-file",
    "allow-check-stamp",
    "allow-reveal",
    "allow-export-file",
    "allow-open-external",
    "allow-sidecar-read",
    "allow-sidecar-write",
    "allow-sidecar-remove",
    "allow-peek-document",
    "allow-project-peek",
    "allow-explorer-open",
    "allow-explorer-list",
    "allow-explorer-create-folder",
    "allow-explorer-save-file",
    "allow-explorer-peek",
    "allow-explorer-add-project",
    "allow-explorer-open-file",
    "allow-explorer-close",
    "allow-pick-project",
    "allow-open-project",
    "allow-project-forget",
    "allow-project-scan",
    "allow-project-open-file",
    "allow-project-grant-file",
    "allow-project-move-file",
    "allow-project-save-new",
    "allow-recents-list",
    "allow-recents-remove",
    "allow-recents-clear",
    "allow-recovery-write",
    "allow-recovery-list",
    "allow-recovery-read",
    "allow-recovery-discard",
    "allow-settings-set",
    "allow-ask",
    "allow-show-error",
    "allow-update-status",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install",
    "allow-update-dismiss",
    "allow-agent-ack",
    "allow-agent-gate",
    "allow-agent-cancel",
    "allow-agent-progress",
    "allow-agent-respond",
    "allow-agent-status",
    "allow-agent-configure",
    "allow-agent-clients",
    "allow-agent-connect-client",
    "allow-agent-skills",
    "allow-agent-install-skill",
    "allow-agent-remove-skill",
    "allow-agent-proposal-list",
    "allow-agent-proposal-get",
    "allow-agent-proposal-begin-accept",
    "allow-agent-proposal-resolve",
    "allow-companion-agents",
    "allow-companion-send",
    "allow-companion-cancel",
    "allow-companion-runs",
