{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Draft Canvas window may ask the shell to do. Every entry is one of the app's own commands; there is deliberately no fs, shell, event, opener or dialog permission, so the page can't reach a file that wasn't handed to it as a handle.",
  "windows": ["main"],
  "permissions": [
    "allow-host-ready",
    "allow-report-state",
    "allow-quit-ack",
    "allow-quit-now",
    "allow-open-dialog",
    "allow-open-handle",
    "allow-save-document",
    "allow-save-as",
    "allow-check-stamp",
    "allow-reveal",
    "allow-export-file",
    "allow-open-external",
    "allow-sidecar-read",
    "allow-sidecar-write",
    "allow-sidecar-remove",
    "allow-pick-project",
    "allow-open-project",
    "allow-project-scan",
    "allow-project-open-file",
    "allow-project-save-new",
    "allow-recents-list",
    "allow-recents-remove",
    "allow-recents-clear",
    "allow-recovery-write",
    "allow-recovery-list",
    "allow-recovery-read",
    "allow-recovery-discard",
    "allow-settings-get",
    "allow-settings-set",
    "allow-ask",
    "allow-show-error"
  ]
}
