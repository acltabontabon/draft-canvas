    "inputSchema": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "description": "Fresh UUID per change; reuse only for an identical retry."
        },
        "diagramId": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "string"
        },
        "view": {
          "type": "object",
          "properties": {
            "inside": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "scope": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "ops": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Ordered ops: {op:\"update\",id,set:{label:\"New name\"}} (also description, technology, etc.; null clears optional fields); {op:\"add\",nodes:[{id,type,label}],relationships:[{id,from,to}],flows:[{id,title,steps:[relationshipId]}]}; {op:\"remove\",ids:[id],cascade?}; {op:\"arrange\",scope?,move?,connectors?,direction?,spacing?,primaryFlow?}; {op:\"setLevel\",level}; {op:\"moveInside\",owner,ids}; {op:\"moveOutside\",ids}. Full fields: get_capabilities({tool:\"update_diagram\"})."
        },
        "layout": {
          "type": "object",
          "description": "Optional direction right|down, spacing compact|comfortable|spacious, primaryFlow id. Advanced fields: get_capabilities({tool:\"create_diagram\"})."
        },
        "summary": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceRef": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "baseCommit": {
              "type": "string"
            },
            "headCommit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "revises": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "diagramId",
        "expectedRevision",
        "summary"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Submit a change proposal",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
