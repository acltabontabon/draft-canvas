{
  "compilerOptions": {
    "target": "ES2023",
    // "DOM" is needed only for typing the browser-context closures passed to Playwright's
    // `page.evaluate`/`page.waitForFunction` (e.g. `window.__dcReady__`, `document.querySelectorAll`)
    // — everything else in this directory is plain Node.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
