{
  "compilerOptions": {
    "target": "ES2023",
    // The CLI itself is plain Node. "DOM" is here only because it compiles the editor's own
    // modules, some of which name browser types in code paths the CLI never runs.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vite/client"]
  },
  "include": ["**/*.ts", "../src/vite-env.d.ts"]
}
