{
  "name": "draft-canvas",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "A local-first canvas for developers to explain software visually.",
  "license": "Apache-2.0",
  "author": {
    "name": "Alvin Cris Tabontabon",
    "email": "me@acltabontabon.com",
    "url": "https://acltabontabon.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acltabontabon/draft-canvas.git"
  },
  "homepage": "https://github.com/acltabontabon/draft-canvas",
  "bugs": {
    "url": "https://github.com/acltabontabon/draft-canvas/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:offline": "playwright test --config=playwright.dist.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "gifenc": "^1.0.3",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "refractor": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
