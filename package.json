{
  "name": "draft-canvas",
  "private": true,
  "version": "1.11.1",
  "type": "module",
  "description": "A local-first canvas for developers to explain software visually.",
  "license": "Apache-2.0",
  "author": {
    "name": "Alvin Cris Tabontabon",
    "email": "me@acltabontabon.com",
    "url": "https://acltabontabon.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acltabontabon/draft-canvas.git"
  },
  "homepage": "https://github.com/acltabontabon/draft-canvas",
  "bugs": {
    "url": "https://github.com/acltabontabon/draft-canvas/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "site:dev": "npm --prefix www run dev",
    "site:build": "npm --prefix www run build",
    "build:web": "npm run build && npm run site:build && node scripts/assemble-web.mjs",
    "site:preview": "npm run build:web && node scripts/stage-subpath.mjs && node scripts/serve-web.mjs",
    "site:shots": "node www/scripts/shots.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:offline": "playwright test --config=playwright.dist.config.ts",
    "e2e:web": "playwright test --config=playwright.web.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck:tooling": "tsc -p e2e && tsc -p benchmark && ([ ! -d demo ] || tsc -p demo)",
    "check": "npm run lint && npm run typecheck:tooling && npm run build && npm test",
    "perf": "tsx benchmark/cli.ts",
    "perf:stress": "tsx benchmark/cli.ts --stress",
    "perf:interaction": "tsx benchmark/interaction-cli.ts",
    "perf:lifecycle": "tsx benchmark/lifecycle-cli.ts",
    "perf:save-baseline": "tsx benchmark/cli.ts --save-baseline",
    "perf:regen-fixtures": "tsx benchmark/workloads/regen-fixtures.ts",
    "perf:publish": "tsx benchmark/publish-results.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:web": "tsc -b && vite build --mode desktop",
    "desktop:build": "tauri build --config src-tauri/tauri.sidecar.conf.json",
    "desktop:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "desktop:version": "node scripts/check-desktop-version.mjs",
    "agent:schemas": "tsx scripts/agent-schemas.ts",
    "agent:sidecar": "node scripts/build-sidecar.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:whats-new": "node scripts/whats-new.mjs",
    "desktop:check": "npm run desktop:web && npm run desktop:rust && npm run desktop:version",
    "e2e:desktop": "playwright test --config=playwright.desktop.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "gifenc": "^1.0.3",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "refractor": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
