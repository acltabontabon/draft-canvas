{
  "name": "draft-canvas",
  "private": true,
  "version": "1.16.1",
  "type": "module",
  "description": "A local-first canvas for developers to explain software visually.",
  "license": "Apache-2.0",
  "author": {
    "name": "Alvin Cris Tabontabon",
    "email": "me@acltabontabon.com",
    "url": "https://acltabontabon.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acltabontabon/draft-canvas.git"
  },
  "homepage": "https://github.com/acltabontabon/draft-canvas",
  "bugs": {
    "url": "https://github.com/acltabontabon/draft-canvas/issues"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:relay": "node scripts/dev-relay.mjs --port 8791",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "site:dev": "npm --prefix www run dev",
    "site:build": "npm --prefix www run build",
    "build:web": "npm run build && npm run site:build && node scripts/assemble-web.mjs",
    "site:preview": "npm run build:web && node scripts/stage-subpath.mjs && node scripts/serve-web.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:offline": "playwright test --config=playwright.dist.config.ts",
    "e2e:web": "playwright test --config=playwright.web.config.ts",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "typecheck:tooling": "tsc -p e2e && tsc -p benchmark && ([ ! -d demo ] || tsc -p demo)",
    "check": "npm run lint && npm run typecheck:tooling && npm run build && npm test",
    "check:full": "npm run check && npm run e2e && npm run e2e:offline && npm run e2e:web",
    "test:coverage": "vitest run --coverage",
    "licenses": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check",
    "icons:generate": "node scripts/technology-catalog.mjs",
    "icons:check": "node scripts/technology-catalog.mjs --check",
    "perf": "tsx benchmark/cli.ts",
    "perf:stress": "tsx benchmark/cli.ts --stress",
    "perf:interaction": "tsx benchmark/interaction-cli.ts",
    "perf:lifecycle": "tsx benchmark/lifecycle-cli.ts",
    "perf:save-baseline": "tsx benchmark/cli.ts --save-baseline",
    "perf:regen-fixtures": "tsx benchmark/workloads/regen-fixtures.ts",
    "perf:publish": "tsx benchmark/publish-results.ts",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:web": "tsc -b && vite build --mode desktop",
    "desktop:build": "tauri build --config src-tauri/tauri.sidecar.conf.json",
    "desktop:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "desktop:version": "node scripts/check-desktop-version.mjs",
    "agent:schemas": "tsx scripts/agent-schemas.ts",
    "agent:sidecar": "node scripts/build-sidecar.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:whats-new": "node scripts/whats-new.mjs",
    "desktop:check": "npm run desktop:web && npm run desktop:rust && npm run desktop:version",
    "e2e:desktop": "playwright test --config=playwright.desktop.config.ts",
    "e2e:mcp": "playwright test --config=playwright.desktop.config.ts e2e/desktop/mcp-roundtrip.spec.ts",
    "audit:npm": "tsx scripts/dependency-audit.ts npm",
    "audit:rust": "tsx scripts/dependency-audit.ts cargo",
    "perf:check": "npm run build && npm run perf:interaction -- --skip-build --sizes medium --scenarios pan-drag,drag-single,select-clicks --iterations 3 && npm run perf:lifecycle -- --skip-build --sizes medium --only load,export && tsx benchmark/gate-cli.ts",
    "desktop:bindings": "node scripts/desktop-bindings.mjs",
    "adoption:compare": "tsx benchmark/adoption/compare.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "@xyflow/system": "0.0.83",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "refractor": "^5.0.0",
    "simple-icons": "16.35.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/hast": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "elkjs": "^0.12.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "mermaid": "^12.0.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "lodash-es": "^4.18.1"
  }
}
