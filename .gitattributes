# The agent skill is compiled into the desktop app and installed byte for byte; its hash is pinned in
# src-tauri/src/agent/skill.rs. A Windows checkout must not turn its line endings into CRLF.
skills/** text eol=lf
# The launch films are tens of megabytes each; Git LFS keeps them out of every clone's history.
docs/media/launch/*.mp4 filter=lfs diff=lfs merge=lfs -text
