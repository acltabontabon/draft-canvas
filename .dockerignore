# Rebuilt inside the image
node_modules
**/node_modules
dist
dist-desktop
dist-ssr
.vite
*.tsbuildinfo

# Repo metadata and tooling that the build doesn't read
.git
.github
.claude
.idea
.vscode
.DS_Store
Dockerfile
.dockerignore

# Docs, media, benchmarks, demo recordings and browser tests.
# `tests/` stays in: `tsc -b` type-checks it as part of `npm run build`.
docs
benchmark
demo
e2e
vscode-extension
# The landing page and the assembled Pages deploy are a separate build the image never serves.
www
dist-web
.preview-web
# The desktop app is built by its own workflow; cargo's target/ alone is gigabytes.
src-tauri
.playwright
test-results
playwright-report
playwright-report-offline
playwright-report-desktop
playwright-report-web
coverage

# Secrets never belong in a build context
.env
.env.*
*.pem
*.key
*.p12
*.crt
