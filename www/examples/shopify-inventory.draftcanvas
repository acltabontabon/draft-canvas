      "text": "Checkout",
      "x": 253,
      "y": 211,
      "width": 187,
      "height": 88,
      "z": 0,
      "accent": "blue",
      "serviceKind": "api",
      "description": "Starts a purchase",
      "attachments": [
        {
          "id": "connection-attribution",
          "type": "note",
          "noteKind": "decision",
          "text": "Checkout tags SQL by business process. ProxySQL uses those tags to measure how long each caller holds a database connection."
        }
      ]
    },
    {
      "id": "reserve",
      "type": "service",
      "text": "Reserve inventory",
      "x": 621,
      "y": 211,
      "width": 214,
      "height": 88,
      "z": 0,
      "accent": "blue",
      "serviceKind": "generic",
      "description": "Holds stock during payment",
      "attachments": [
        {
          "id": "skip-locked",
          "type": "code",
          "text": "Illustrative reservation SQL",
          "language": "sql",
          "code": "SELECT id\nFROM reservation_units\nWHERE shop_id = ?\n  AND inventory_item_id = ?\n  AND inventory_group_id = ?\nLIMIT ? FOR UPDATE SKIP LOCKED;"
        },
        {
          "id": "lock-order",
          "type": "note",
          "noteKind": "decision",
          "text": "In the reserve transaction, delete the selected unit rows before inserting the hold into reserved_quantities. Shopify also used READ COMMITTED to avoid gap locks that could block replenishment."
        }
      ]
    },
    {
      "id": "claim",
      "type": "service",
      "text": "Claim inventory",
      "x": 621,
      "y": 381,
      "width": 214,
      "height": 88,
      "z": 0,
      "accent": "teal",
      "serviceKind": "generic",
      "description": "Finalizes a paid purchase"
    },
