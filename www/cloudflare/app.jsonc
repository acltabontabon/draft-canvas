// app.draftcanvas.dev — the editor (dist/, unchanged), served as static assets on an origin of its
// own: its IndexedDB, service worker and storage are never the site's.
{
  "name": "draftcanvas-app",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../app",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "app.draftcanvas.dev", "custom_domain": true }]
}
