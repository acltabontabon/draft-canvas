// draftcanvas.dev — the landing page and the docs (www/dist), served as static assets.
// scripts/assemble-web.mjs copies this folder into dist-web/cloudflare/, beside the builds it names.
{
  "name": "draftcanvas-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Wrangler creates the DNS record and certificate for a custom domain on deploy.
  "routes": [{ "pattern": "draftcanvas.dev", "custom_domain": true }]
}
