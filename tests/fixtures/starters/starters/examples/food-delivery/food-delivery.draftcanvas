  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "settings": {
    "showSequence": true,
    "grid": "dots"
  },
  "flows": [
    {
      "id": "f.order",
      "title": "Place an order",
      "steps": [
        {
          "id": "f.order.s1",
          "edgeId": "order",
          "caption": "A customer orders two ramen bowls and pays in the app."
        },
        {
          "id": "f.order.s2",
          "edgeId": "capp-api",
          "caption": "The app posts the basket with an idempotency key."
        },
        {
          "id": "f.order.s3",
          "edgeId": "api",
          "caption": "The gateway checks the customer's token."
        },
        {
          "id": "f.order.s4",
          "edgeId": "r-orders",
          "caption": "The order reaches the Orders API."
        },
        {
          "id": "f.order.s5",
          "edgeId": "write",
          "extraNodeIds": [
            "outbox"
          ],
          "caption": "The order row and its OrderPlaced event commit together…"
        },
        {
          "id": "f.order.s6",
          "edgeId": "stage",
          "caption": "…in one transaction, so neither can exist without the other."
        },
        {
          "id": "f.order.s7",
          "edgeId": "start",
          "caption": "A PlaceOrder workflow starts; the app gets 201 straight away."
        },
        {
          "id": "f.order.s8",
          "edgeId": "authorize",
          "caption": "First, the amount is held on the card."
        },
        {
          "id": "f.order.s9",
          "edgeId": "charge",
          "caption": "Stripe authorizes €32.50; nothing is captured yet."
        },
        {
          "id": "f.order.s10",
          "edgeId": "send",
          "caption": "Then the ticket goes to the restaurant."
        },
        {
          "id": "f.order.s11",
          "edgeId": "take",
          "caption": "Restaurant Integration picks it up."
        },
        {
          "id": "f.order.s12",
          "edgeId": "pos-call",
          "caption": "The POS prints it and answers: accepted, ready in 18 min."
        },
        {
          "id": "f.order.s13",
          "edgeId": "assign",
          "caption": "Now a courier is booked."
        },
        {
          "id": "f.order.s14",
          "edgeId": "near",
          "caption": "Dispatch picks the best courier from live positions."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "f.reject",
      "title": "Restaurant rejects the order",
      "steps": [
        {
          "id": "f.reject.s1",
          "edgeId": "pos-call",
          "caption": "The kitchen is out of ramen: the ticket is rejected."
        },
        {
          "id": "f.reject.s2",
          "edgeId": "refund",
          "extraNodeIds": [
            "stripe"
          ],
          "caption": "The saga runs its undo stack: the hold is released."
        },
        {
          "id": "f.reject.s3",
          "edgeId": "relay",
          "caption": "OrderCancelled leaves through the outbox."
        },
        {
          "id": "f.reject.s4",
          "edgeId": "notify",
          "caption": "The Notifier picks it up…"
        },
        {
          "id": "f.reject.s5",
          "edgeId": "push",
          "caption": "…and pushes the bad news."
        },
        {
          "id": "f.reject.s6",
          "edgeId": "tell",
          "caption": "The customer sees 'Sorry, the restaurant can't take it' and no charge."
        },
        {
          "id": "f.reject.s7",
          "edgeId": "tell.in",
          "caption": "The push lands on the customer's phone."
        }
      ],
      "accent": "rose",
      "variantOf": "f.order"
    },
    {
      "id": "f.silent",
      "title": "Restaurant doesn't answer",
      "steps": [
        {
          "id": "f.silent.s1",
          "edgeId": "send",
          "caption": "The ticket is sent, and a 3-minute timer starts."
        },
        {
          "id": "f.silent.s2",
          "edgeId": "cancel",
          "caption": "No answer in 3 minutes: the ticket is cancelled first…"
        },
        {
          "id": "f.silent.s3",
          "edgeId": "refund",
          "caption": "…then the payment hold is released, newest step first."
        }
      ],
      "accent": "amber",
      "variantOf": "f.order"
    },
    {
      "id": "f.deliver",
      "title": "Courier delivers",
      "steps": [
        {
          "id": "f.deliver.s1",
          "edgeId": "drive",
          "caption": "The courier accepts the offer and rides to the restaurant."
        },
        {
          "id": "f.deliver.s2",
          "edgeId": "courier-api",
          "caption": "Every 4 s the app sends its position."
        },
        {
          "id": "f.deliver.s3",
          "edgeId": "api",
          "caption": "Through the same gateway as every other app."
        },
        {
          "id": "f.deliver.s4",
          "edgeId": "r-couriers",
          "caption": "Dispatch records pickup and drop-off."
        },
        {
          "id": "f.deliver.s5",
          "edgeId": "r-couriers.in",
          "caption": "The courier app talks to Dispatch."
        },
        {
          "id": "f.deliver.s6",
          "edgeId": "near",
          "caption": "Live positions update in Redis."
        },
        {
          "id": "f.deliver.s7",
          "edgeId": "relay",
          "caption": "Each status change becomes an event."
        },
        {
          "id": "f.deliver.s8",
          "edgeId": "notify",
          "caption": "The Notifier turns it into a message."
        },
        {
          "id": "f.deliver.s9",
          "edgeId": "push",
          "caption": "Firebase delivers it."
        },
        {
          "id": "f.deliver.s10",
          "edgeId": "tell",
          "caption": "“Your courier is 2 minutes away.”"
        },
        {
          "id": "f.deliver.s11",
          "edgeId": "tell.in",
          "caption": "The push lands on the customer's phone."
        }
      ],
      "accent": "blue"
    },
    {
      "id": "f.browse",
      "title": "Browse and search",
      "steps": [
        {
          "id": "f.browse.s1",
          "edgeId": "capp-api",
          "caption": "The customer opens the app and types 'ramen'."
        },
        {
          "id": "f.browse.s2",
          "edgeId": "api",
          "caption": "The gateway serves anonymous browsing too."
        },
        {
          "id": "f.browse.s3",
          "edgeId": "r-browse",
          "caption": "Restaurants answers with what's open nearby."
        },
        {
          "id": "f.browse.s4",
          "edgeId": "find",
          "caption": "Dishes are matched by name, cuisine and distance."
        }
      ],
      "accent": "violet"
    },
    {
      "id": "f.payout",
      "title": "Weekly payouts",
      "steps": [
        {
          "id": "f.payout.s1",
          "edgeId": "land",
          "caption": "Every order, fee and tip streams into the warehouse."
        },
        {
          "id": "f.payout.s2",
          "edgeId": "week",
          "caption": "Every Monday, earnings are summed per restaurant and courier."
        },
        {
          "id": "f.payout.s3",
          "edgeId": "payout",
          "caption": "Stripe pays each partner's bank account."
        },
        {
          "id": "f.payout.s4",
          "edgeId": "payout.in",
          "caption": "Stripe receives the payout batch."
        }
      ],
      "accent": "green"
    }
  ],
