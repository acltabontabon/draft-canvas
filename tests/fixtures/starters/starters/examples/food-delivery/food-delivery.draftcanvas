      "routing": "smoothstep",
      "semantic": "calls",
      "semanticsOrigin": "inferred",
      "attachments": [
        {
          "id": "n.wf",
          "type": "code",
          "language": "typescript",
          "code": "const hold = await authorize(order);\nundo.push(() => refund(hold));\nconst ticket = await sendTicket(order);\nundo.push(() => cancelTicket(ticket));\nconst ok = await condition(() => answered, '3 min');\nif (!ok || rejected) return unwind(undo);\nawait findCourier(order);",
          "width": 422,
          "height": 177.625
        }
      ]
    },
