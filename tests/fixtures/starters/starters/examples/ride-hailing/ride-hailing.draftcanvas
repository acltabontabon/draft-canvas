  "flows": [
    {
      "id": "f.request",
      "title": "Request a ride",
      "steps": [
        {
          "id": "f.request.s1",
          "edgeId": "request",
          "caption": "A rider sets a pickup and taps Request."
        },
        {
          "id": "f.request.s2",
          "edgeId": "rider-api",
          "caption": "The app posts the trip."
        },
        {
          "id": "f.request.s3",
          "edgeId": "api",
          "caption": "The gateway checks the rider's session."
        },
        {
          "id": "f.request.s4",
          "edgeId": "r-trips",
          "caption": "Trips creates the trip in REQUESTED, with a fixed fare."
        },
        {
          "id": "f.request.s5",
          "edgeId": "hold",
          "caption": "The fare is held on the rider's card first."
        },
        {
          "id": "f.request.s6",
          "edgeId": "match",
          "caption": "Trips asks Dispatch for a driver."
        },
        {
          "id": "f.request.s7",
          "edgeId": "nearby",
          "caption": "Dispatch finds free drivers within 2 km of the pickup."
        },
        {
          "id": "f.request.s8",
          "edgeId": "eta-call",
          "caption": "They are ranked by how soon each can reach the rider."
        },
        {
          "id": "f.request.s9",
          "edgeId": "routes",
          "caption": "ETAs use live traffic on real roads."
        },
        {
          "id": "f.request.s10",
          "edgeId": "state",
          "caption": "The trip moves to OFFERED."
        },
        {
          "id": "f.request.s11",
          "edgeId": "push",
          "caption": "The notifier picks up the change."
        },
        {
          "id": "f.request.s12",
          "edgeId": "send",
          "caption": "A push goes to the best driver's phone."
        },
        {
          "id": "f.request.s13",
          "edgeId": "offer",
          "caption": "The driver has 15 seconds to accept."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "f.none",
      "title": "No driver nearby",
      "steps": [
        {
          "id": "f.none.s1",
          "edgeId": "match",
          "caption": "Rush hour: every driver near the pickup is busy."
        },
        {
          "id": "f.none.s2",
          "edgeId": "nearby",
          "extraNodeIds": [
            "geo"
          ],
          "caption": "Nobody within 2 km, so the search widens to 5 km."
        },
        {
          "id": "f.none.s3",
          "edgeId": "supply",
          "caption": "Requests outnumber drivers here, so surge rises and draws drivers in."
        }
      ],
      "accent": "amber",
      "variantOf": "f.request"
    },
    {
      "id": "f.cancel",
      "title": "Rider cancels",
      "steps": [
        {
          "id": "f.cancel.s1",
          "edgeId": "r-trips",
          "caption": "The rider cancels before the driver arrives."
        },
        {
          "id": "f.cancel.s2",
          "edgeId": "release",
          "caption": "Trips releases the card hold: nothing is charged."
        },
        {
          "id": "f.cancel.s3",
          "edgeId": "state",
          "caption": "The trip moves to CANCELLED."
        },
        {
          "id": "f.cancel.s4",
          "edgeId": "push",
