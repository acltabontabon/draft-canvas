      "databaseKind": "cache",
      "attachments": [
        {
          "id": "n.h3",
          "type": "code",
          "language": "plaintext",
          "code": "cell  = h3.latlng_to_cell(lat, lng, 9)\nring  = h3.grid_disk(cell, 2)      # ~2 km\nfree  = redis.sunion(\n          *[f\"free:{c}\" for c in ring])\nsurge = redis.get(f\"surge:{cell}\")",
          "width": 347,
          "height": 138.875
        }
      ]
    },
