  "edges": [
    {
      "id": "browse",
      "source": "shopper",
      "target": "web",
      "label": "Checks out",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "calls",
      "semanticsOrigin": "inferred"
    },
    {
      "id": "submit",
      "source": "web",
      "target": "api",
      "label": "POST /orders",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "http",
      "response": "202 Accepted",
      "hasResponse": true,
      "semanticsOrigin": "explicit"
    },
    {
      "id": "charge",
      "source": "api",
      "target": "stripe",
      "label": "Authorizes payment",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "http",
      "response": "authorized",
      "hasResponse": true,
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.idem",
          "type": "code",
          "language": "http",
          "code": "POST /v1/payment_intents\nIdempotency-Key: order-8f14e45f\n\namount=4999&currency=eur\n&capture_method=manual",
          "width": 264.5,
          "height": 138.875
        }
      ]
    },
    {
      "id": "save",
      "source": "api",
      "target": "db",
      "label": "Stores the order",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "readsWrites",
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.dual",
          "type": "note",
          "text": "Storing the order and sending the command are two writes. If the API dies between them, the order is never shipped. The Transactional Outbox starter closes that gap.",
          "noteKind": "warning",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "enqueue",
      "source": "api",
      "target": "queue",
      "label": "FulfilOrder",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "command",
      "kind": "async",
      "async": true,
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.accept",
          "type": "note",
          "text": "Accept fast, fulfil later: the shopper waits for the payment, never for the warehouse.",
          "noteKind": "decision",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "process",
      "source": "queue",
      "target": "worker",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "consumes",
      "kind": "async",
      "async": true,
      "semanticsOrigin": "explicit"
    },
    {
      "id": "book",
      "source": "worker",
      "target": "wms",
      "label": "Books shipment",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "http",
      "response": "201 Shipment",
      "hasResponse": true,
      "semanticsOrigin": "explicit"
    },
    {
      "id": "mark",
      "source": "worker",
      "target": "shipments",
      "label": "Tracking number",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "writes",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "park",
      "source": "queue",
      "target": "dlq",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "deadLetters",
      "kind": "failure",
      "async": true,
      "semanticsOrigin": "explicit",
      "deliveryAttempts": 5
    }
  ],
  "viewport": {
    "x": 0,
