  "flows": [
    {
      "id": "place",
      "title": "Place an order",
      "steps": [
        {
          "id": "place.s1",
          "edgeId": "browse",
          "caption": "A shopper confirms the basket and pays."
        },
        {
          "id": "place.s2",
          "edgeId": "submit",
          "caption": "Checkout posts the order; the API answers 202 without waiting for the warehouse."
        },
        {
          "id": "place.s3",
          "edgeId": "charge",
          "caption": "The card is authorized, keyed by the order id so a retry never charges twice."
        },
        {
          "id": "place.s4",
          "edgeId": "save",
          "caption": "The order is stored as PAID."
        },
        {
          "id": "place.s5",
          "edgeId": "enqueue",
          "caption": "A FulfilOrder command is queued for the workers."
        },
        {
          "id": "place.s6",
          "edgeId": "process",
          "caption": "One of four workers takes the message; the others take the next ones."
        },
        {
          "id": "place.s7",
          "edgeId": "book",
          "caption": "The worker books the shipment with the warehouse."
        },
        {
          "id": "place.s8",
          "edgeId": "mark",
          "caption": "The tracking number is stored and the message deleted."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "refused",
      "title": "Warehouse keeps refusing",
      "steps": [
        {
          "id": "refused.s1",
          "edgeId": "process",
          "extraNodeIds": [
            "wms"
          ],
          "caption": "The warehouse is down. The message returns to the queue and is tried again."
        },
        {
          "id": "refused.s2",
          "edgeId": "park",
          "caption": "After five attempts SQS parks it in the DLQ; on-call redrives it once the warehouse is back."
        }
      ],
      "accent": "rose",
      "variantOf": "place"
    }
  ],
  "openPoints": [
    {
      "id": "op.capture",
      "kind": "awaiting",
      "context": "Capture the payment when the parcel ships, or at checkout? Finance to confirm.",
      "targets": [
        {
          "kind": "edge",
          "id": "charge"
        },
        {
          "kind": "edge",
          "id": "book"
        }
      ]
    }
  ],
  "level": "container"
}
