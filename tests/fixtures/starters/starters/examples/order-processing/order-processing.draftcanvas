        "flows": [
          {
            "id": "c.flow",
            "title": "Place an order, inside the API",
            "steps": [
              {
                "id": "c.flow.s1",
                "edgeId": "c.post",
                "caption": "The controller validates the basket and hands it to the use case."
              },
              {
                "id": "c.flow.s2",
                "edgeId": "c.handle",
                "caption": "Place Order owns the business rules: price, charge, record, queue."
              },
              {
                "id": "c.flow.s3",
                "edgeId": "c.authorize",
                "caption": "The card is authorized first; nothing is stored for a declined card."
              },
              {
                "id": "c.flow.s4",
                "edgeId": "c.stripe-call",
                "caption": "Stripe authorizes the amount, keyed by the order id."
              },
              {
                "id": "c.flow.s5",
                "edgeId": "c.save",
                "caption": "The order is saved as PAID."
              },
              {
                "id": "c.flow.s6",
                "edgeId": "c.sql",
                "caption": "One row per order, one per line."
              },
              {
                "id": "c.flow.s7",
                "edgeId": "c.send",
                "caption": "Fulfilment is requested only once the order is stored."
              },
              {
                "id": "c.flow.s8",
                "edgeId": "c.sqs",
                "caption": "The command goes on the queue; the controller answers 202."
              }
            ],
            "accent": "blue"
          }
        ],
