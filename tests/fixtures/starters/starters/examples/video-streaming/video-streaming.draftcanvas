  "flows": [
    {
      "id": "f.play",
      "title": "Press play",
      "steps": [
        {
          "id": "f.play.s1",
          "edgeId": "watch",
          "caption": "A viewer picks a film on the TV and presses play."
        },
        {
          "id": "f.play.s2",
          "edgeId": "tv-api",
          "caption": "The TV calls the API, like every other device."
        },
        {
          "id": "f.play.s3",
          "edgeId": "api",
          "caption": "One edge gateway in the nearest region takes the call."
        },
        {
          "id": "f.play.s4",
          "edgeId": "play",
          "caption": "It is authenticated and routed to the Playback API."
        },
        {
          "id": "f.play.s5",
          "edgeId": "licence",
          "caption": "Rights, streams and edges are chosen; a DRM licence is signed."
        },
        {
          "id": "f.play.s6",
          "edgeId": "segments",
          "caption": "The TV fetches 4-second chunks from an appliance inside its ISP."
        },
        {
          "id": "f.play.s7",
          "edgeId": "heartbeat",
          "caption": "Every 30 s the session reports position and quality."
        },
        {
          "id": "f.play.s8",
          "edgeId": "aggregate",
          "caption": "Flink folds heartbeats per session."
        },
        {
          "id": "f.play.s9",
          "edgeId": "progress",
          "caption": "Where the viewer stopped is saved for Continue Watching."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "f.miss",
      "title": "The edge doesn't have it",
      "steps": [
        {
          "id": "f.miss.s1",
          "edgeId": "segments",
          "caption": "A brand-new title, not yet filled to this appliance."
        },
        {
          "id": "f.miss.s2",
          "edgeId": "miss",
          "extraNodeIds": [
            "origin"
          ],
          "caption": "The appliance fetches the chunk from the origin and keeps it."
        }
      ],
      "accent": "amber",
      "variantOf": "f.play"
    },
    {
      "id": "f.browse",
      "title": "Open the home screen",
      "steps": [
        {
          "id": "f.browse.s1",
          "edgeId": "mobile-api",
          "caption": "The app asks for the home screen in one GraphQL query."
        },
        {
          "id": "f.browse.s2",
          "edgeId": "api",
          "caption": "The gateway checks the session token."
        },
        {
          "id": "f.browse.s3",
          "edgeId": "home",
          "caption": "The query goes to the Discovery Graph."
        },
        {
          "id": "f.browse.s4",
          "edgeId": "rank",
          "caption": "Recommendations ranks forty rows for this profile."
        },
        {
          "id": "f.browse.s5",
          "edgeId": "feat",
          "caption": "Ranking reads the profile's features from Redis."
        },
        {
          "id": "f.browse.s6",
          "edgeId": "titles",
          "caption": "Titles, artwork and availability fill each row."
        },
        {
          "id": "f.browse.s7",
          "edgeId": "resume",
          "caption": "Continue Watching comes from the viewing history."
        }
      ],
      "accent": "blue"
    },
    {
      "id": "f.launch",
      "title": "Launch a new title",
      "steps": [
        {
          "id": "f.launch.s1",
          "edgeId": "deliver",
          "caption": "The studio delivers the master and subtitles."
        },
        {
          "id": "f.launch.s2",
          "edgeId": "encode",
          "caption": "Hundreds of streams are encoded and stored at the origin."
        },
        {
          "id": "f.launch.s3",
          "edgeId": "fill",
          "caption": "Off-peak, appliances pull what their viewers will want tomorrow."
        },
        {
          "id": "f.launch.s4",
          "edgeId": "launch",
          "caption": "At launch time the title becomes available in the catalog."
        },
        {
          "id": "f.launch.s5",
          "edgeId": "find",
          "caption": "It is indexed, so viewers can find it by name."
        }
      ],
      "accent": "violet"
    },
    {
      "id": "f.learn",
      "title": "Retrain recommendations",
      "steps": [
        {
          "id": "f.learn.s1",
          "edgeId": "archive",
          "caption": "Every event lands in the lake, hourly."
        },
        {
          "id": "f.learn.s2",
          "edgeId": "learn",
          "caption": "At night, Spark trains on a year of viewing."
        },
        {
          "id": "f.learn.s3",
          "edgeId": "publish-model",
          "caption": "Fresh features go live without a deploy."
        }
      ],
      "accent": "green"
    }
