        "flows": [
          {
            "id": "i.flow",
            "title": "Release an album",
            "steps": [
              {
                "id": "i.flow.s1",
                "edgeId": "i.upload",
                "caption": "The portal posts a DDEX release with twelve WAV files."
              },
              {
                "id": "i.flow.s2",
                "edgeId": "i.record",
                "caption": "Credits, territories and the release date are recorded."
              },
              {
                "id": "i.flow.s3",
                "edgeId": "i.queue",
                "caption": "One encode job is queued per track."
              },
              {
                "id": "i.flow.s4",
                "edgeId": "i.take",
                "caption": "Twenty encoders work through the jobs."
              },
              {
                "id": "i.flow.s5",
                "edgeId": "i.measure",
                "caption": "Loudness is measured so playback can even it out."
              },
              {
                "id": "i.flow.s6",
                "edgeId": "i.store",
                "caption": "Five bitrates per track are stored, ready for the CDN."
              }
            ],
            "accent": "violet"
          }
