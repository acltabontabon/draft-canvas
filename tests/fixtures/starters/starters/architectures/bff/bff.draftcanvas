          {
            "id": "m.flow",
            "title": "Home screen, inside the Mobile BFF",
            "steps": [
              {
                "id": "m.flow.s1",
                "edgeId": "m.query",
                "caption": "The app sends one HomeScreen query."
              },
              {
                "id": "m.flow.s2",
                "edgeId": "m.resolve",
