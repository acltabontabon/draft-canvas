    },
    {
      "id": "web-page",
      "title": "Open a title page on the web",
      "steps": [
        {
          "id": "web-page.s1",
          "edgeId": "use-web",
          "caption": "A viewer opens a series page in the browser."
        },
        {
          "id": "web-page.s2",
          "edgeId": "web-call",
          "caption": "The web app asks its BFF for the page in one request."
        },
        {
          "id": "web-page.s3",
          "edgeId": "web-catalog",
          "caption": "The Web BFF fetches seasons, episodes and artwork…"
