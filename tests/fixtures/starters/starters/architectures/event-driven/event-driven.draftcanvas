  "flows": [
    {
      "id": "placed",
      "title": "An order is placed",
      "steps": [
        {
          "id": "placed.s1",
          "edgeId": "place",
          "caption": "A diner places an order."
        },
        {
          "id": "placed.s2",
          "edgeId": "store",
          "caption": "The Orders Service stores it and answers 201."
        },
        {
          "id": "placed.s3",
          "edgeId": "publish",
          "extraNodeIds": [
            "topic"
          ],
          "caption": "It publishes OrderPlaced once, not knowing who listens."
        },
        {
          "id": "placed.s4",
          "edgeId": "fan-restaurant",
          "caption": "SNS copies the event into the restaurant relay's queue…"
        },
        {
          "id": "placed.s5",
          "edgeId": "consume-restaurant",
          "caption": "The relay picks it up at its own pace."
        },
        {
          "id": "placed.s6",
          "edgeId": "ticket",
          "caption": "A ticket prints in the restaurant's kitchen."
        },
        {
          "id": "placed.s7",
          "edgeId": "fan-dispatch",
          "caption": "…and, independently, into Dispatch's queue."
        },
        {
          "id": "placed.s8",
          "edgeId": "consume-dispatch",
          "caption": "One of four dispatch workers takes it."
        },
        {
          "id": "placed.s9",
          "edgeId": "assign",
          "caption": "The nearest free courier is booked."
        },
        {
          "id": "placed.s10",
          "edgeId": "fan-notify",
          "caption": "A third copy goes to Notifications."
        },
        {
          "id": "placed.s11",
          "edgeId": "consume-notify",
          "caption": "Notifications reads it from its own queue."
        },
        {
          "id": "placed.s12",
          "edgeId": "sms",
          "caption": "The diner gets a text: the order is confirmed."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "pos-down",
      "title": "Restaurant POS is offline",
      "steps": [
        {
          "id": "pos-down.s1",
          "edgeId": "fan-restaurant",
          "caption": "The event reaches the relay's queue as usual."
        },
        {
          "id": "pos-down.s2",
          "edgeId": "consume-restaurant",
          "extraNodeIds": [
            "pos"
          ],
          "caption": "The POS doesn't answer; the message reappears and is retried."
        },
        {
          "id": "pos-down.s3",
          "edgeId": "park",
          "extraNodeIds": [
            "dispatch-q",
            "notify-q"
          ],
          "caption": "After four attempts it moves to the DLQ. Couriers and texts are unaffected."
        }
      ],
      "accent": "rose",
      "variantOf": "placed"
    }
  ],
  "openPoints": [
    {
      "id": "op.schema",
      "kind": "tentative",
      "context": "OrderPlaced v1 carries the pickup location so Dispatch never calls back. Revisit if restaurants move.",
      "targets": [
        {
          "kind": "edge",
          "id": "publish"
        }
      ]
    }
  ],
  "level": "container"
}
