  "flows": [
    {
      "id": "send-flow",
      "title": "Send money over HTTP",
      "steps": [
        {
          "id": "send-flow.s1",
          "edgeId": "send",
          "caption": "A customer sends €250 to a friend."
        },
        {
          "id": "send-flow.s2",
          "edgeId": "http-call",
          "caption": "The controller turns JSON into a SendMoney command on the port."
        },
        {
          "id": "send-flow.s3",
          "edgeId": "inbound-impl",
          "caption": "The use case behind the port takes over; HTTP stops here."
        },
        {
          "id": "send-flow.s4",
          "edgeId": "use-fraud-port",
          "caption": "The core asks its own FraudCheck port, not a vendor."
        },
        {
          "id": "send-flow.s5",
          "edgeId": "fraud-impl",
          "caption": "The adapter behind the port knows the vendor."
        },
        {
          "id": "send-flow.s6",
          "edgeId": "call-fraud",
          "caption": "The vendor scores the transfer as low risk."
        },
        {
          "id": "send-flow.s7",
          "edgeId": "use-accounts-port",
          "caption": "Both accounts are loaded through AccountStore."
        },
        {
          "id": "send-flow.s8",
          "edgeId": "use-domain",
          "caption": "The Account model withdraws and deposits by its own rules."
        },
        {
          "id": "send-flow.s9",
          "edgeId": "accounts-impl",
          "caption": "The JPA adapter saves both accounts."
        },
        {
          "id": "send-flow.s10",
          "edgeId": "write-database",
          "caption": "One transaction, guarded by a version column."
        },
        {
          "id": "send-flow.s11",
          "edgeId": "use-events-port",
          "caption": "The use case announces MoneySent through its port."
        },
        {
          "id": "send-flow.s12",
          "edgeId": "events-impl",
          "caption": "The Kafka adapter does the publishing."
        },
        {
          "id": "send-flow.s13",
          "edgeId": "publish",
          "caption": "MoneySent lands on the transfers topic."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "rejected",
      "title": "Fraud check rejects",
      "steps": [
        {
          "id": "rejected.s1",
          "edgeId": "use-fraud-port",
          "caption": "The use case asks FraudCheck to screen the transfer."
        },
        {
          "id": "rejected.s2",
          "edgeId": "fraud-impl",
          "caption": "The adapter behind the port calls the vendor."
        },
        {
          "id": "rejected.s3",
          "edgeId": "call-fraud",
          "caption": "The vendor scores 0.93; the adapter maps it to Verdict.REJECT, and nothing moves."
        }
      ],
      "accent": "rose",
      "variantOf": "send-flow"
    },
    {
      "id": "standing",
      "title": "Run standing orders",
      "steps": [
        {
          "id": "standing.s1",
          "edgeId": "job-call",
          "caption": "At 06:00 the job sends each standing order due today."
        },
        {
          "id": "standing.s2",
          "edgeId": "inbound-impl",
          "caption": "A different technology, the same port and the same use case."
        },
        {
          "id": "standing.s3",
          "edgeId": "use-accounts-port",
          "caption": "Accounts are loaded exactly as for an HTTP transfer."
        },
        {
          "id": "standing.s4",
          "edgeId": "use-domain",
          "caption": "The same rules apply: limits, overdraft, currency."
        }
      ],
      "accent": "blue"
    }
  ],
  "level": "component"
}
