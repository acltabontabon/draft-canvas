      "attachments": [
        {
          "id": "n.test",
          "type": "code",
          "language": "plaintext",
          "code": "val service = SendMoneyService(\n    accounts = InMemoryAccountStore(),\n    fraud = FraudCheck { Verdict.ALLOW },\n    events = RecordingEvents(),\n)",
          "width": 339.5,
          "height": 138.875
        }
      ]
    },
