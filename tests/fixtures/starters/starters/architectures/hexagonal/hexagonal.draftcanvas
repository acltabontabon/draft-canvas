        "flows": [
          {
            "id": "d.flow",
            "title": "Withdraw, inside the model",
            "steps": [
              {
                "id": "d.flow.s1",
                "edgeId": "d.withdraw",
                "caption": "The use case asks the Account to withdraw; it never sets the balance."
              },
              {
                "id": "d.flow.s2",
                "edgeId": "d.check",
                "caption": "The Account checks the daily limit and overdraft rules."
              },
              {
                "id": "d.flow.s3",
                "edgeId": "d.subtract",
                "caption": "Money does the arithmetic in the account's currency."
              },
              {
                "id": "d.flow.s4",
                "edgeId": "d.raise",
                "caption": "A MoneySent event is recorded for the use case to publish."
              }
