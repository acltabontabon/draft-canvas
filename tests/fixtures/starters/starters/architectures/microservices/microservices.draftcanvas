      },
      "targetAnchor": {
        "side": "left",
        "offset": 0.5
      },
      "semanticsOrigin": "explicit"
    },
    {
      "id": "price",
      "source": "orders",
      "target": "restaurants",
      "label": "GetPrices",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "grpc",
      "response": "prices",
      "hasResponse": true,
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.chain",
          "type": "note",
          "text": "A synchronous call chains availability: when Restaurants is down, nobody can order. The breaker fails fast instead of piling up threads.",
          "noteKind": "warning",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "persist-orders",
      "source": "orders",
      "target": "orders-db",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "readsWrites",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "persist-menus",
      "source": "restaurants",
      "target": "menus-db",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "readsWrites",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "publish",
      "source": "orders",
      "target": "events",
      "label": "OrderPlaced",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "publishes",
      "kind": "event",
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.events",
          "type": "note",
          "text": "Services share events and APIs, never tables. Delivery learns about orders from OrderPlaced, not from Orders DB.",
          "noteKind": "decision",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "to-delivery",
      "source": "events",
      "target": "delivery",
      "label": "Courier request",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "deliversTo",
      "kind": "event",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "nearest",
      "source": "delivery",
      "target": "locations",
      "label": "Nearest couriers",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "readsWrites",
      "semanticsOrigin": "explicit"
    }
