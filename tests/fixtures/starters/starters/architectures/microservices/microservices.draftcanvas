          "width": 200,
          "height": 56
        },
        {
          "id": "n.kong",
          "type": "code",
          "language": "yaml",
          "code": "routes:\n  - name: orders\n    paths: [/orders]\n    service: orders-service\n    plugins:\n      - name: jwt\n      - name: rate-limiting\n        config: { minute: 60 }",
          "width": 260,
          "height": 197
        }
      ]
    },
