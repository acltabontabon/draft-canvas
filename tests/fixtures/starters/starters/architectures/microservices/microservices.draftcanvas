  "edges": [
    {
      "id": "use",
      "source": "customer",
      "target": "app",
      "label": "Orders dinner",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "calls",
      "semanticsOrigin": "inferred"
    },
    {
      "id": "call",
      "source": "app",
      "target": "gateway",
      "label": "POST /orders",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "http",
      "response": "201 Created",
