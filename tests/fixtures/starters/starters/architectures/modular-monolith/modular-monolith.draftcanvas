          {
            "id": "e.flow",
            "title": "Enrol, inside the module",
            "steps": [
              {
                "id": "e.flow.s1",
                "edgeId": "e.call",
                "caption": "Callers only ever see EnrollmentApi; everything else is package-private."
              },
              {
                "id": "e.flow.s2",
                "edgeId": "e.impl",
                "caption": "The service behind the interface runs the use case."
              },
              {
                "id": "e.flow.s3",
                "edgeId": "e.save",
                "caption": "A seat is held for the learner."
              },
              {
                "id": "e.flow.s4",
                "edgeId": "e.sql",
                "caption": "Only the enrollment schema is touched."
              },
              {
                "id": "e.flow.s5",
                "edgeId": "e.charge",
                "caption": "Payment goes through Billing's own public interface."
              },
              {
                "id": "e.flow.s6",
                "edgeId": "e.publish",
                "caption": "Once committed, EnrollmentCompleted is published in process."
              }
            ],
            "accent": "blue"
          }
