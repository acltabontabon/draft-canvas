  "flows": [
    {
      "id": "enrol",
      "title": "Enrol in a course",
      "steps": [
        {
          "id": "enrol.s1",
          "edgeId": "request",
          "caption": "A learner enrols in the March cohort."
        },
        {
          "id": "enrol.s2",
          "edgeId": "dispatch",
          "caption": "The Web API calls Enrollment's public interface, nothing deeper."
        },
        {
          "id": "enrol.s3",
          "edgeId": "seats",
          "caption": "Enrollment asks Catalog for seats left, through Catalog's interface."
        },
        {
          "id": "enrol.s4",
          "edgeId": "persist-enrollment",
          "caption": "A seat is held in Enrollment's own tables."
        },
        {
          "id": "enrol.s5",
          "edgeId": "charge",
          "caption": "Billing is asked to charge the course price."
        },
        {
          "id": "enrol.s6",
          "edgeId": "pay",
          "caption": "Billing charges the card with Stripe."
        },
        {
          "id": "enrol.s7",
          "edgeId": "persist-billing",
          "caption": "The charge and invoice land in Billing's own tables."
        },
        {
          "id": "enrol.s8",
          "edgeId": "completed",
          "caption": "After commit, EnrollmentCompleted goes to listening modules."
        },
        {
          "id": "enrol.s9",
          "edgeId": "email",
          "caption": "Notifications sends the welcome email."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "declined",
      "title": "Card declined",
      "steps": [
        {
          "id": "declined.s1",
          "edgeId": "pay",
          "caption": "Stripe declines the card; Billing records the failed charge."
        },
        {
          "id": "declined.s2",
          "edgeId": "charge",
          "caption": "Billing answers Declined to Enrollment, a plain return value."
        },
        {
          "id": "declined.s3",
          "edgeId": "persist-enrollment",
          "caption": "Enrollment releases the held seat. No event is published."
        }
      ],
      "accent": "rose",
      "variantOf": "enrol"
    }
  ],
  "level": "component"
