      "z": -1,
      "text": "Application",
      "textOrigin": "explicit",
      "boundaryPreset": "deployment",
      "attachments": [
        {
          "id": "a_9n06gnlpudn8",
          "type": "note",
          "text": "One artifact, one deploy — the same unit as the Monolith. Module boundaries are enforced at build time (packages, visibility, dependency rules), not by the network.",
          "noteKind": "note",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
