  "flows": [
    {
      "id": "book",
      "title": "Book an appointment",
      "steps": [
        {
          "id": "book.s1",
          "edgeId": "visit",
          "caption": "A patient picks a free slot on the booking site."
        },
        {
          "id": "book.s2",
          "edgeId": "route",
          "caption": "NGINX sends the request to any of the three identical app copies."
        },
        {
          "id": "book.s3",
          "edgeId": "session",
          "caption": "The app reads the session and the cached free slots from Redis."
        },
        {
          "id": "book.s4",
          "edgeId": "sql",
          "caption": "The slot is booked in one transaction; a slot taken meanwhile is refused."
        },
        {
          "id": "book.s5",
          "edgeId": "sms",
          "caption": "The app texts the patient a confirmation before answering."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "sms-down",
      "title": "Vonage is down",
      "steps": [
        {
          "id": "sms-down.s1",
          "edgeId": "sms",
          "extraNodeIds": [
            "db"
          ],
          "caption": "The text times out after 3 s. The error is logged; the booking stands."
        }
      ],
      "accent": "amber",
      "variantOf": "book"
    },
    {
      "id": "checkin",
      "title": "Check a patient in",
      "steps": [
        {
          "id": "checkin.s1",
          "edgeId": "desk",
          "caption": "The front desk opens today's schedule on the staff screens."
        },
        {
          "id": "checkin.s2",
          "edgeId": "route",
          "caption": "The same app, the same deploy, serves the staff screens."
        },
        {
          "id": "checkin.s3",
