      "width": 280,
      "height": 142,
      "z": 0,
      "parentId": "command-side",
      "text": "Payments API",
      "description": "Validates commands and records what happened.",
      "technology": "Spring Boot 3",
      "textOrigin": "explicit",
      "serviceKind": "api",
      "replicas": 2,
      "inside": {
        "nodes": [
          {
            "id": "c.app",
            "type": "service",
            "x": 0,
            "y": 76.5,
            "width": 176,
            "height": 68,
            "z": 0,
            "text": "Banking App",
            "technology": "React Native",
            "textOrigin": "explicit",
            "serviceKind": "generic"
          },
          {
            "id": "c.controller",
            "type": "component",
            "x": 303,
            "y": 61,
            "width": 152,
            "height": 114,
            "z": 0,
            "text": "Transfers Controller",
            "description": "Checks the request and its idempotency key.",
            "technology": "Spring",
            "textOrigin": "explicit",
            "componentKind": "generic"
          },
          {
            "id": "c.handler",
            "type": "component",
            "x": 603,
            "y": 61,
            "width": 152,
            "height": 114,
            "z": 0,
            "text": "Send Money Handler",
            "description": "Loads the account and applies the command.",
            "textOrigin": "explicit",
            "componentKind": "generic"
          },
          {
            "id": "c.aggregate",
            "type": "component",
            "x": 904,
            "y": 4.5,
            "width": 152,
            "height": 114,
            "z": 0,
            "text": "Account Aggregate",
            "description": "Enforces balance and limits; decides the events.",
            "textOrigin": "explicit",
            "componentKind": "generic"
          },
          {
            "id": "c.repo",
            "type": "component",
            "x": 890,
            "y": 121,
            "width": 180,
            "height": 175,
            "z": 0,
            "text": "Event Store Repository",
            "description": "Replays an account's events; appends new ones.",
            "technology": "PostgreSQL",
            "textOrigin": "explicit",
            "componentKind": "adapter"
          },
          {
            "id": "c.store",
            "type": "database",
            "x": 1211,
            "y": 121,
            "width": 160,
            "height": 141,
            "z": 0,
            "text": "Ledger Event Store",
            "technology": "PostgreSQL 16",
            "textOrigin": "explicit",
            "databaseKind": "sql"
          }
        ],
        "edges": [
          {
            "id": "c.post",
            "source": "c.app",
            "target": "c.controller",
            "label": "POST /transfers",
            "directed": true,
            "routing": "smoothstep",
            "semantic": "http",
            "response": "202 Accepted",
            "hasResponse": true,
            "semanticsOrigin": "explicit"
          },
          {
            "id": "c.dispatch",
            "source": "c.controller",
            "target": "c.handler",
            "label": "handle(SendMoney)",
            "directed": true,
            "routing": "smoothstep",
            "semantic": "uses",
            "semanticsOrigin": "explicit"
          },
          {
            "id": "c.decide",
            "source": "c.handler",
            "target": "c.aggregate",
            "label": "send(amount, to)",
            "directed": true,
            "routing": "smoothstep",
            "semantic": "uses",
            "sourceAnchor": {
              "side": "right",
              "offset": 0.25
            },
            "targetAnchor": {
              "side": "left",
              "offset": 0.75
            },
            "semanticsOrigin": "explicit"
          },
          {
            "id": "c.persist",
            "source": "c.handler",
            "target": "c.repo",
            "label": "load / append",
            "directed": true,
            "routing": "smoothstep",
            "semantic": "uses",
            "sourceAnchor": {
              "side": "right",
              "offset": 0.75
            },
            "targetAnchor": {
              "side": "left",
              "offset": 0.25
            },
            "semanticsOrigin": "explicit"
          },
          {
            "id": "c.sql",
            "source": "c.repo",
            "target": "c.store",
            "label": "Events by account",
            "directed": true,
            "routing": "smoothstep",
            "semantic": "readsWrites",
            "semanticsOrigin": "explicit"
          }
        ],
        "flows": [
          {
            "id": "c.flow",
            "title": "Send money, inside the Payments API",
            "steps": [
              {
                "id": "c.flow.s1",
                "edgeId": "c.post",
                "caption": "The controller checks the request; a repeated idempotency key stops here."
              },
              {
                "id": "c.flow.s2",
                "edgeId": "c.dispatch",
                "caption": "The SendMoney command goes to its one handler."
              },
              {
                "id": "c.flow.s3",
                "edgeId": "c.persist",
                "caption": "The handler loads the account by replaying its events."
              },
              {
                "id": "c.flow.s4",
                "edgeId": "c.sql",
                "extraNodeIds": [
                  "c.store"
                ],
                "caption": "Events come back in version order."
              },
              {
                "id": "c.flow.s5",
                "edgeId": "c.decide",
                "caption": "The aggregate checks balance and limits, then decides MoneySent."
              }
            ],
            "accent": "teal"
          }
        ],
        "viewport": {
          "x": 0,
          "y": 0,
          "zoom": 1
        },
        "level": "component"
      }
    },
    {
      "id": "event-store",
      "type": "database",
      "x": 950,
      "y": 111,
      "width": 220,
      "height": 179,
      "z": 0,
      "parentId": "command-side",
      "text": "Ledger Event Store",
      "description": "Every account change, append-only.",
      "technology": "PostgreSQL 16",
      "textOrigin": "explicit",
      "databaseKind": "sql",
      "attachments": [
        {
          "id": "n.schema",
          "type": "code",
          "language": "sql",
          "code": "CREATE TABLE ledger_events (\n  account_id  text   NOT NULL,\n  version     bigint NOT NULL,\n  type        text   NOT NULL,\n  payload     jsonb  NOT NULL,\n  recorded_at timestamptz DEFAULT now(),\n  PRIMARY KEY (account_id, version)  -- two writers can't both take v1043\n);",
          "width": 579.5,
          "height": 197
        }
      ]
    },
    {
      "id": "relay",
      "type": "service",
      "x": 1270,
      "y": 129,
      "width": 260,
      "height": 142,
      "z": 0,
      "parentId": "command-side",
      "text": "Change Relay",
      "description": "Streams committed events out of the store.",
      "technology": "Debezium",
      "textOrigin": "explicit",
      "serviceKind": "worker"
    },
    {
      "id": "events",
      "type": "queue",
      "x": 1670,
      "y": 141,
      "width": 140,
      "height": 119,
      "z": 0,
      "text": "ledger-events",
      "description": "The ledger's events, in order per account.",
      "technology": "Kafka",
      "textOrigin": "explicit",
      "queueKind": "stream"
    },
    {
      "id": "projector",
      "type": "service",
      "x": 1310,
      "y": 542,
      "width": 180,
      "height": 157,
      "z": 0,
      "parentId": "query-side",
      "text": "Projection Worker",
      "description": "Folds events into read models shaped for questions.",
      "technology": "Go",
      "textOrigin": "explicit",
      "serviceKind": "worker",
      "replicas": 3
    },
    {
      "id": "dlq",
      "type": "queue",
      "x": 1330,
      "y": 761,
      "width": 140,
      "height": 119,
      "z": 0,
      "parentId": "query-side",
      "text": "ledger-dlq",
      "description": "Events a projection couldn't apply.",
      "technology": "Kafka",
      "textOrigin": "explicit",
      "queueKind": "queue",
      "deliveryRole": "dead-letter"
    },
    {
      "id": "balances",
      "type": "database",
      "x": 990,
      "y": 408,
      "width": 140,
      "height": 145,
      "z": 0,
      "parentId": "query-side",
      "text": "Balances",
      "description": "Balance per account.",
      "technology": "Redis 7",
      "textOrigin": "explicit",
      "databaseKind": "nosql"
    },
    {
      "id": "statements",
      "type": "database",
      "x": 960,
      "y": 733,
      "width": 200,
      "height": 174,
      "z": 0,
      "parentId": "query-side",
      "text": "Statements",
      "description": "Searchable transaction history.",
      "technology": "OpenSearch",
      "textOrigin": "explicit",
      "databaseKind": "search-index",
      "attachments": [
        {
          "id": "n.rebuild",
          "type": "note",
          "text": "Rebuilding Statements from offset 0 takes about six hours. Do we need a second index to swap in?",
          "noteKind": "question",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "query-api",
      "type": "service",
      "x": 590,
      "y": 549,
      "width": 260,
      "height": 142,
      "z": 0,
      "parentId": "query-side",
      "text": "Accounts API",
      "description": "Answers questions; never changes anything.",
      "technology": "NestJS",
      "textOrigin": "explicit",
      "serviceKind": "api",
      "replicas": 4
    },
    {
      "id": "title",
      "type": "text",
      "x": -280,
      "y": -107,
      "width": 1100,
      "height": 110,
      "z": 0,
      "text": "# CQRS\nCommands append to a ledger; projections answer every question from views built for it.",
      "textOrigin": "explicit",
      "textRole": "title"
    }
  ],
  "edges": [
    {
      "id": "use",
      "source": "customer",
      "target": "app",
      "label": "Sends money",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "calls",
      "semanticsOrigin": "inferred"
    },
    {
      "id": "transfer",
      "source": "app",
      "target": "command-api",
      "label": "POST /transfers",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "http",
      "response": "202 Accepted",
      "hasResponse": true,
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.ack",
          "type": "note",
          "text": "Commands answer 202 and an id, never the new balance: the query side may still be catching up.",
          "noteKind": "decision",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "append",
      "source": "command-api",
      "target": "event-store",
      "label": "Appends MoneySent",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "readsWrites",
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.event",
          "type": "code",
          "language": "json",
          "code": "{\n  \"type\": \"MoneySent\",\n  \"accountId\": \"acc_51f2\",\n  \"version\": 1043,\n  \"amount\": { \"value\": \"40.00\", \"currency\": \"EUR\" },\n  \"to\": \"acc_9b07\",\n  \"transferId\": \"tr_8813\"\n}",
          "width": 422,
          "height": 197
        }
      ]
    },
    {
      "id": "capture",
      "source": "event-store",
      "target": "relay",
      "label": "Tails the WAL",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "reads",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "publish",
      "source": "relay",
      "target": "events",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "publishes",
      "kind": "event",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "deliver",
      "source": "events",
      "target": "projector",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "consumes",
      "kind": "event",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "project-balance",
      "source": "projector",
      "target": "balances",
      "label": "Updates balance",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "writes",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "project-statement",
      "source": "projector",
      "target": "statements",
      "label": "Indexes transaction",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "indexes",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "park",
      "source": "projector",
      "target": "dlq",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "deadLetters",
      "kind": "failure",
      "async": true,
      "semanticsOrigin": "explicit",
      "deliveryAttempts": 3
    },
    {
      "id": "view",
      "source": "app",
      "target": "query-api",
      "label": "GET /accounts/:id",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "http",
      "response": "200 Balance",
      "hasResponse": true,
      "semanticsOrigin": "explicit"
    },
    {
      "id": "read-balance",
      "source": "balances",
      "target": "query-api",
      "label": "Balance lookup",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "reads",
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.lag",
          "type": "note",
          "text": "Reads lag writes by the projection delay (p99 ≈ 400 ms). The app shows its own pending transfer until the balance catches up.",
          "noteKind": "warning",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "search",
      "source": "statements",
      "target": "query-api",
      "label": "Transaction search",
      "directed": true,
      "routing": "smoothstep"
    }
  ],
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "settings": {
    "showSequence": true,
    "grid": "dots"
  },
  "flows": [
    {
      "id": "send",
      "title": "Send money",
      "steps": [
        {
          "id": "send.s1",
          "edgeId": "use",
          "caption": "A customer sends €40 to a friend."
        },
        {
          "id": "send.s2",
          "edgeId": "transfer",
          "caption": "The app posts a SendMoney command; the API answers 202 with an id."
        },
        {
          "id": "send.s3",
          "edgeId": "append",
          "caption": "MoneySent is appended at the account's next version."
        },
        {
          "id": "send.s4",
          "edgeId": "capture",
          "caption": "Once committed, the relay reads the event from the write-ahead log."
        },
        {
          "id": "send.s5",
          "edgeId": "publish",
          "caption": "It publishes the event, keyed by account so order is kept."
        },
        {
          "id": "send.s6",
          "edgeId": "deliver",
          "caption": "A projection worker picks it up."
        },
        {
          "id": "send.s7",
          "edgeId": "project-balance",
          "caption": "The balance read model drops by €40…"
        },
        {
          "id": "send.s8",
          "edgeId": "project-statement",
          "caption": "…and the transaction becomes searchable."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "read",
      "title": "Check the balance",
      "steps": [
        {
          "id": "read.s1",
          "edgeId": "view",
          "caption": "The customer opens their account."
        },
        {
          "id": "read.s2",
          "edgeId": "read-balance",
          "caption": "The balance is one key lookup; nothing is computed on read."
        },
        {
          "id": "read.s3",
          "edgeId": "search",
          "caption": "Recent transactions come from the search index."
        }
      ],
      "accent": "blue"
    },
    {
      "id": "stale",
      "title": "Read before the projection catches up",
      "steps": [
        {
          "id": "stale.s1",
          "edgeId": "view",
          "caption": "The customer checks the balance a moment after sending."
        },
        {
          "id": "stale.s2",
          "edgeId": "read-balance",
          "extraNodeIds": [
            "projector"
          ],
          "caption": "The read model may still show the old balance for a few hundred ms."
        }
      ],
      "accent": "amber",
      "variantOf": "read"
    },
    {
      "id": "poison",
      "title": "A projection can't apply an event",
      "steps": [
        {
          "id": "poison.s1",
          "edgeId": "deliver",
          "caption": "The worker receives an event it can't apply (say, an unknown currency)."
        },
        {
          "id": "poison.s2",
          "edgeId": "park",
          "caption": "After three tries it parks the event and moves on; the account's reads go stale."
        }
      ],
      "accent": "rose",
      "variantOf": "send"
    }
  ],
  "openPoints": [
    {
      "id": "op.retention",
      "kind": "parked",
      "context": "How long ledger-events keeps history: forever (replay any projection) or 30 days plus snapshots.",
      "targets": [
        {
          "kind": "node",
          "id": "events"
        }
      ]
    }
  ],
  "level": "container"
}
