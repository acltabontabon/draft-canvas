  },
  "nodes": [
    {
      "id": "client",
      "type": "actor",
      "x": -60,
      "y": -332,
      "width": 120,
      "height": 92,
      "z": 0,
      "text": "Client",
      "textOrigin": "explicit",
      "actorKind": "system",
      "actorFrame": "borderless"
    },
    {
      "id": "command-box",
      "type": "group",
      "x": -702,
      "y": -136,
      "width": 512,
      "height": 468,
      "z": -1,
      "text": "Command side",
      "textOrigin": "explicit",
      "boundaryPreset": "boundary",
      "attachments": [
        {
          "id": "a_2h3q1zgbotbc",
          "type": "note",
          "text": "A logical side, not a deployment: the two sides can be one process and one database. CQRS requires neither messaging, event sourcing nor separate services — this starter adds an asynchronous projection as one common variant. Its topic carries facts about what changed and is not an event store: nothing replays it. A direct in-process update or a database change feed would feed the projection just as well.",
          "noteKind": "note",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "command-subtitle",
      "type": "text",
      "x": -690,
      "y": -106,
      "width": 200,
      "height": 24,
      "z": 0,
      "parentId": "command-box",
      "text": "Validates intent, changes state",
      "textOrigin": "explicit",
      "annotation": true
    },
    {
      "id": "command-api",
      "type": "service",
      "x": -666,
      "y": -74,
      "width": 176,
      "height": 68,
      "z": 0,
      "parentId": "command-box",
      "text": "Command API",
      "textOrigin": "explicit",
      "accent": "teal",
      "serviceKind": "api",
      "attachments": [
        {
          "id": "a_drngg579jhqr",
          "type": "code",
          "text": "Example command",
          "language": "json",
          "code": "{\n  \"type\": \"ChangeStatus\",\n  \"entityId\": \"ent_4821\",\n  \"status\": \"active\"\n}",
          "width": 380,
          "height": 180
        }
      ]
    },
    {
      "id": "command-handler",
      "type": "component",
      "x": -654,
      "y": 66,
      "width": 152,
      "height": 56,
      "z": 0,
      "parentId": "command-box",
      "text": "Command Handler",
      "textOrigin": "explicit",
      "componentKind": "generic"
    },
    {
      "id": "write-store",
      "type": "database",
      "x": -664,
      "y": 194,
      "width": 172,
      "height": 102,
      "z": 0,
      "parentId": "command-box",
      "text": "Write Store",
      "textOrigin": "explicit",
      "accent": "blue",
      "databaseKind": "generic"
    },
    {
      "id": "relay",
      "type": "service",
      "x": -402,
      "y": 195,
      "width": 176,
      "height": 68,
      "z": 0,
      "parentId": "command-box",
      "text": "Outbox Relay",
      "textOrigin": "explicit",
      "accent": "teal",
      "serviceKind": "worker"
    },
    {
      "id": "events",
      "type": "queue",
      "x": -70,
      "y": 212,
      "width": 140,
      "height": 72,
      "z": 0,
      "text": "Domain Events",
      "textOrigin": "explicit",
      "queueKind": "topic"
    },
    {
      "id": "consistency",
      "type": "text",
      "x": -110,
      "y": 304,
      "width": 220,
      "height": 24,
      "z": 0,
      "text": "Eventually consistent read projection",
      "textOrigin": "explicit",
      "annotation": true
    },
    {
      "id": "query-box",
      "type": "group",
      "x": 190,
      "y": -136,
      "width": 512,
      "height": 468,
      "z": -1,
      "text": "Query side",
      "textOrigin": "explicit",
      "boundaryPreset": "boundary",
      "attachments": [
        {
          "id": "a_jv5iiiiadk8w",
          "type": "note",
          "text": "Reads are answered from a model shaped for the questions asked. Only the projection writes here; the Query API never does.",
          "noteKind": "note",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "query-subtitle",
      "type": "text",
      "x": 202,
      "y": -106,
      "width": 200,
      "height": 24,
      "z": 0,
      "parentId": "query-box",
      "text": "Answers questions, changes nothing",
      "textOrigin": "explicit",
      "annotation": true
    },
    {
      "id": "query-api",
      "type": "service",
      "x": 490,
      "y": -74,
      "width": 176,
      "height": 68,
      "z": 0,
      "parentId": "query-box",
      "text": "Query API",
      "textOrigin": "explicit",
      "accent": "teal",
      "serviceKind": "api"
    },
    {
      "id": "projector",
      "type": "service",
      "x": 226,
      "y": 195,
      "width": 176,
      "height": 68,
      "z": 0,
      "parentId": "query-box",
      "text": "Projection Worker",
      "textOrigin": "explicit",
      "accent": "teal",
      "serviceKind": "worker"
    },
    {
      "id": "read-store",
      "type": "database",
      "x": 492,
      "y": 194,
      "width": 172,
      "height": 102,
      "z": 0,
      "parentId": "query-box",
      "text": "Read Store",
      "textOrigin": "explicit",
      "accent": "blue",
      "databaseKind": "generic",
      "attachments": [
        {
          "id": "a_gbompiwdw9yr",
          "type": "note",
          "text": "Shaped for the questions asked of it — a projection, not the write model. It may be a second schema in the same database: CQRS separates models, not necessarily databases.",
          "noteKind": "note",
          "width": 200,
          "height": 56
        }
      ]
    }
  ],
