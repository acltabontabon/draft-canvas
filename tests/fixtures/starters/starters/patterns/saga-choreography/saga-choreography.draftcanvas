  "flows": [
    {
      "id": "flow1",
      "title": "Happy path",
      "steps": [
        {
          "id": "fs_fbororop7587",
          "edgeId": "commit-order",
          "caption": "Order commits locally"
        },
        {
          "id": "fs_2p8z6raz2wi8",
          "edgeId": "place",
          "caption": "And publishes the fact"
        },
        {
          "id": "fs_gfa0uovp9m5n",
          "edgeId": "take",
          "caption": "Payment reacts — nobody told it to"
        },
        {
          "id": "fs_0bdl8lyhn3r9",
          "edgeId": "commit-payment",
          "caption": "Its own local transaction"
        },
        {
          "id": "fs_7l3wbxtvoiz1",
          "edgeId": "taken"
        },
        {
          "id": "fs_wjds70riyvbp",
          "edgeId": "reserve",
          "caption": "Inventory reacts in turn"
        },
        {
          "id": "fs_iotneh3caf27",
          "edgeId": "commit-inventory",
          "caption": "Stock reserved"
        },
        {
          "id": "fs_jom3b35rp4m1",
          "edgeId": "reserved",
          "caption": "And that is published like any other fact"
        },
        {
          "id": "fs_z32ygfoi6alu",
          "edgeId": "confirm",
          "caption": "Order reacts: confirmed — the saga completed with no one in charge"
        }
      ],
      "accent": "green"
    },
    {
      "id": "flow2",
      "title": "Compensation",
      "steps": [
        {
          "id": "fs_qdkirjc77al6",
          "edgeId": "reserve",
          "caption": "Inventory cannot reserve the stock"
        },
        {
          "id": "fs_8ypi62424idn",
          "edgeId": "reject",
          "caption": "It publishes the failure as an event"
        },
        {
          "id": "fs_ml90h38b8egg",
          "edgeId": "refund",
          "caption": "Payment reacts: a refund, a new local transaction"
        },
        {
          "id": "fs_eps6w77s5mjj",
          "edgeId": "commit-payment",
          "caption": "Committed locally"
        },
        {
          "id": "fs_iecn42gsobrc",
          "edgeId": "refunded",
          "caption": "And published — the unwinding continues the same way"
        },
        {
          "id": "fs_xfvkrel5ybc8",
          "edgeId": "cancel",
          "caption": "Order reacts: cancelled. Every hop was one more reaction"
        }
      ],
      "accent": "rose"
    }
  ]
