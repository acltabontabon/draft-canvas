      "text": "Stock Reserved",
      "textOrigin": "explicit",
      "queueKind": "topic",
      "attachments": [
        {
          "id": "a_nhzvwsf12vls",
          "type": "note",
          "text": "The last participant publishes the outcome like any other fact, and Order reacts to it — confirming the order is its own local transaction. Nobody reports to anybody.",
          "noteKind": "note",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "rejected",
      "type": "queue",
      "x": 200,
      "y": -159,
      "width": 140,
      "height": 72,
      "z": 0,
      "text": "Stock Rejected",
      "textOrigin": "explicit",
      "queueKind": "topic",
      "attachments": [
        {
          "id": "a_72mgzhjsls4n",
          "type": "note",
          "text": "Compensation is event-driven too: Payment refunds and publishes Payment Refunded, and Order reacts to that by cancelling. Every hop of the unwinding is one more reaction.",
          "noteKind": "note",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "refunded",
      "type": "queue",
      "x": -340,
      "y": -159,
      "width": 140,
      "height": 72,
      "z": 0,
      "text": "Payment Refunded",
      "textOrigin": "explicit",
      "queueKind": "topic"
    }
  ],
