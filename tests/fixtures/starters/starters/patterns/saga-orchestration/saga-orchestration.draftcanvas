      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.idem",
          "type": "note",
          "text": "Compensations are retried until they succeed, so every DELETE must be idempotent — releasing a seat twice is a no-op.",
          "noteKind": "warning",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "cancel-room",
      "source": "orchestrator",
      "target": "hotels",
      "label": "DELETE /reservations/{id}",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "compensates",
      "compensationFor": "reserve-room",
      "compensationVisible": true,
      "compensationName": "Cancel room",
      "compensationProtocol": "http",
      "sourceAnchor": {
        "side": "left",
        "offset": 0.5789
      },
      "targetAnchor": {
        "side": "right",
        "offset": 0.7938
      },
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.semantic",
          "type": "note",
          "text": "Not a rollback: the room was really reserved for a moment. A cancellation fee is a business decision, not a database one.",
          "noteKind": "note",
          "width": 200,
          "height": 56
        }
      ]
    },
