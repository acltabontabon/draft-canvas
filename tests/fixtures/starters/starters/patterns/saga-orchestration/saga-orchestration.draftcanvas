  "flows": [
    {
      "id": "flow1",
      "title": "Happy path",
      "steps": [
        {
          "id": "fs_wz1rpr3juudy",
          "edgeId": "start"
        },
        {
          "id": "fs_04e4z4oesyyc",
          "edgeId": "reserve-payment"
        },
        {
          "id": "fs_5433e6zt4vup",
          "edgeId": "commit-payment",
          "caption": "Local transaction commits — and the reply says \"reserved\""
        },
        {
          "id": "fs_qso4f8csehjm",
          "edgeId": "reserve-inventory",
          "caption": "Only on that reply does the next step go out"
        },
        {
          "id": "fs_e0pw3ydzcj3o",
          "edgeId": "commit-inventory",
          "caption": "Local transaction commits, reply \"reserved\""
        },
        {
          "id": "fs_vcxzkhta1dj7",
          "edgeId": "schedule-fulfillment"
        },
        {
          "id": "fs_e5lnawwt9fra",
          "edgeId": "commit-fulfillment",
          "caption": "Local transaction commits, reply \"scheduled\" — saga complete"
        }
      ],
      "accent": "green"
    },
    {
      "id": "flow2",
      "title": "Compensation",
      "steps": [
        {
          "id": "fs_63q2hfx9b5cj",
          "edgeId": "reserve-payment",
          "caption": "Reply: reserved"
        },
        {
          "id": "fs_wd26dc3kotyd",
          "edgeId": "commit-payment",
          "caption": "Committed locally — nothing outside can roll it back"
        },
        {
          "id": "fs_wditsizwh18u",
          "edgeId": "reserve-inventory",
          "caption": "Reply: reserved, and committed locally too"
        },
        {
          "id": "fs_qjzg3kljk73c",
          "edgeId": "schedule-fulfillment",
          "caption": "Reply: failed — the orchestrator now runs the sweep"
        },
        {
          "id": "fs_okkd6elf0ydo",
          "edgeId": "release-inventory",
          "caption": "Undo the last committed step first — a new local transaction"
        },
        {
          "id": "fs_j48zn44n5bcv",
          "edgeId": "release-payment",
          "caption": "Then the one before it"
        }
      ],
      "accent": "rose"
    }
  ]
