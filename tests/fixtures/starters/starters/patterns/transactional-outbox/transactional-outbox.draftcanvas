      "attachments": [
        {
          "id": "n.tx",
          "type": "code",
          "language": "sql",
          "code": "BEGIN;\nUPDATE accounts SET balance = balance - 250.00\n WHERE id = 'acc_17' AND version = 42;\nINSERT INTO transfers (id, from_acc, to_iban, amount)\n VALUES ('tr_9c1', 'acc_17', 'DE89 3704…', 250.00);\nINSERT INTO outbox (id, aggregate_id, type, payload)\n VALUES ('ev_51f', 'tr_9c1', 'TransferInitiated',\n         '{\"amount\": \"250.00\", \"currency\": \"EUR\"}');\nCOMMIT;",
          "width": 429.5,
          "height": 216.375
        }
      ],
