  "edges": [
    {
      "id": "request",
      "source": "holder",
      "target": "api",
      "label": "Sends €250",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "calls",
      "response": "201 Transfer",
      "hasResponse": true,
      "semanticsOrigin": "inferred"
    },
    {
      "id": "debit",
      "source": "api",
      "target": "accounts",
      "label": "UPDATE balance",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "writes",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "record",
      "source": "api",
      "target": "transfers",
      "label": "INSERT transfer",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "writes",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "intent",
      "source": "api",
      "target": "outbox",
      "label": "INSERT event",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "writes",
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.never",
          "type": "note",
          "text": "Never publish to Kafka inside the transaction: a broker outage would block transfers, and a rollback cannot unsend.",
          "noteKind": "decision",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "tail",
      "source": "outbox",
      "target": "relay",
      "label": "New rows (WAL)",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "reads",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "publish",
      "source": "relay",
      "target": "topic",
      "label": "TransferInitiated",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "publishes",
      "kind": "event",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "deliver",
      "source": "topic",
      "target": "notify",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "consumes",
      "kind": "event",
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.once",
          "type": "note",
          "text": "At least once, never exactly once: every consumer must deduplicate by event id.",
          "noteKind": "warning",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "dedupe",
      "source": "notify",
      "target": "inbox",
      "label": "Records event id",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "readsWrites",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "push",
      "source": "notify",
      "target": "fcm",
      "label": "Push",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "http",
      "semanticsOrigin": "explicit"
    }
  ],
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "settings": {
    "showSequence": true,
    "grid": "dots"
  },
  "flows": [
    {
      "id": "send",
      "title": "Send money",
      "steps": [
        {
          "id": "send.s1",
          "edgeId": "request",
          "caption": "The holder sends €250 to a friend's IBAN."
        },
        {
          "id": "send.s2",
          "edgeId": "debit",
          "extraNodeIds": [
            "ledger"
          ],
          "caption": "BEGIN: the balance is debited…"
        },
        {
          "id": "send.s3",
          "edgeId": "record",
          "caption": "…the transfer is recorded…"
        },
        {
          "id": "send.s4",
          "edgeId": "intent",
          "caption": "…and TransferInitiated is added to the outbox. COMMIT: all three, or none."
        },
        {
          "id": "send.s5",
          "edgeId": "tail",
          "caption": "After the commit, Debezium reads the new outbox row from the WAL."
        },
        {
          "id": "send.s6",
          "edgeId": "publish",
          "caption": "It publishes the event to Kafka, keyed by transfer id."
        },
        {
          "id": "send.s7",
          "edgeId": "deliver",
          "caption": "Notification Service receives it."
        },
        {
          "id": "send.s8",
          "edgeId": "dedupe",
          "caption": "It records the event id; it has not seen this one before."
        },
        {
          "id": "send.s9",
          "edgeId": "push",
          "caption": "The holder's phone shows \"€250 sent\"."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "duplicate",
      "title": "Relay crashes mid-publish",
      "steps": [
        {
          "id": "duplicate.s1",
          "edgeId": "publish",
          "caption": "Debezium publishes, then dies before saving its offset."
        },
        {
          "id": "duplicate.s2",
          "edgeId": "deliver",
          "caption": "On restart it re-reads the row: the event arrives a second time."
        },
        {
          "id": "duplicate.s3",
          "edgeId": "dedupe",
          "caption": "The id is already in processed_messages: skipped, no second push."
        }
      ],
      "accent": "rose",
      "variantOf": "send"
    }
  ],
  "openPoints": [
    {
      "id": "op.order",
      "kind": "awaiting",
      "context": "Do consumers need events per account in order? Then key by account id, not transfer id.",
      "targets": [
        {
          "kind": "edge",
          "id": "publish"
        }
      ]
    }
  ],
  "level": "container"
}
