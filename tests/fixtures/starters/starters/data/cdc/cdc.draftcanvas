  "flows": [
    {
      "id": "flow1",
      "title": "Capture and fan out",
      "steps": [
        {
          "id": "fs_0bnp6op30jyg",
          "edgeId": "write",
          "caption": "One write, to its own database only"
        },
        {
          "id": "fs_pc9q29zbw70p",
          "edgeId": "capture",
          "caption": "Captured from the log once committed"
        },
        {
          "id": "fs_7wu3w7fg6btj",
          "edgeId": "publish",
          "caption": "Published once, as a change event"
        },
        {
          "id": "fs_3rubuizexxob",
          "edgeId": "consume-search",
          "caption": "The search indexer reads it at its own pace"
        },
        {
          "id": "fs_z27y25e4zwt8",
          "edgeId": "index",
          "caption": "…and updates the index"
        },
        {
          "id": "fs_i9zls6w30j5w",
          "edgeId": "consume-warehouse",
          "caption": "The same change, read independently"
        },
        {
          "id": "fs_ffexopkyx0a2",
          "edgeId": "project",
          "caption": "…and loads it for analytics"
        }
      ],
      "accent": "teal"
    }
  ]
