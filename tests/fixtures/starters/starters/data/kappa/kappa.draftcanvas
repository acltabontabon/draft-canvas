      "semanticsOrigin": "explicit"
    },
    {
      "id": "consume-live",
      "source": "log",
      "target": "live",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "consumes",
      "cadence": "Streaming",
      "kind": "event",
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.window",
          "type": "code",
          "language": "sql",
          "code": "SELECT card_id,\n       COUNT(*)    AS auths_5m,\n       SUM(amount) AS spend_5m\nFROM card_events\nGROUP BY card_id,\n  HOP(event_time, INTERVAL '1' MINUTE, INTERVAL '5' MINUTE);",
          "width": 482,
          "height": 158.25
        }
      ]
    },
    {
      "id": "consume-replay",
      "source": "log",
      "target": "replay",
      "label": "Replays from offset 0",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "consumes",
      "cadence": "On demand",
      "kind": "event",
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.cost",
          "type": "note",
          "text": "A full replay reads every event ever written. Budget hours of cluster time, and keep v7 serving until v8 has caught up.",
          "noteKind": "warning",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "park",
      "source": "live",
      "target": "dlq",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "deadLetters",
      "kind": "failure",
      "async": true,
      "semanticsOrigin": "explicit"
    },
    {
      "id": "write-live",
      "source": "live",
      "target": "view7",
      "label": "Upserts scores",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "writes",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "write-replay",
      "source": "replay",
      "target": "view8",
      "label": "Upserts scores",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "writes",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "serve",
      "source": "view7",
      "target": "api",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "reads",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "cutover",
      "source": "view8",
      "target": "api",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "reads",
      "condition": "after cutover",
      "semanticsOrigin": "explicit"
    },
